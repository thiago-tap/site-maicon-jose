---
import {
  escolherDestaque,
  filmesDaGrade,
  metaDoFilme,
  rotulosTipoFilme,
  tipoDoFilme,
  tiposPresentes,
  urlDaCapa,
  type FilmeVitrine,
  type TipoFilme,
} from '../data/filmes'

type Props = {
  filmes: FilmeVitrine[]
  slugTenant?: string
  /** home: curado (sem verticais na grade, máx. 7 + destaque). arquivo: todos horizontais. */
  modo?: 'home' | 'arquivo'
  mostrarFiltros?: boolean
  linkArquivo?: string
}

const {
  filmes,
  slugTenant = 'maicon-jose',
  modo = 'home',
  mostrarFiltros = true,
  linkArquivo = '/filmes',
} = Astro.props

const horizontais = filmes.filter((f) => tipoDoFilme(f) !== 'vertical')
const destaque = escolherDestaque(horizontais)
const maxGrade = modo === 'home' ? 7 : undefined
const grade = filmesDaGrade(horizontais, destaque, { incluirVerticais: false, max: maxGrade })
const capaDestaque = destaque ? urlDaCapa(destaque, slugTenant) : undefined
const metaDestaque = destaque ? metaDoFilme(destaque) : ''
const poolFiltro = [destaque, ...grade].filter(Boolean) as FilmeVitrine[]
const tipos: TipoFilme[] = tiposPresentes(poolFiltro).filter((t) => t !== 'vertical')
const temFiltros = mostrarFiltros && tipos.length > 1
const tituloSecao = modo === 'arquivo' ? 'Arquivo de filmes' : 'Nossos filmes'
const leadSecao =
  modo === 'arquivo'
    ? 'Filtre por categoria e assista no cinema da página.'
    : 'Cada história é única. Os filmes capturam a essência e a emoção do dia — com ritmo de cinema.'
const ocultosNoArquivo =
  modo === 'home' && horizontais.length > (grade.length + (destaque ? 1 : 0))
---

{
  destaque ? (
<section class="filmes" id="filmes" data-filmes-cinema data-modo={modo}>
  <div class="container">
    <p class="rotulo revelar">Portfólio</p>
    <h2 class="titulo-secao revelar">{tituloSecao}</h2>
    <p class="lead revelar">{leadSecao}</p>

    {
      temFiltros ? (
        <div class="filmes__filtros revelar" data-filmes-filtros role="group" aria-label="Filtrar filmes">
          <button type="button" class="chip" data-filtro="todos" aria-pressed="true">
            Todos
          </button>
          {tipos.map((tipo) => (
            <button type="button" class="chip" data-filtro={tipo} aria-pressed="false">
              {rotulosTipoFilme[tipo]}
            </button>
          ))}
        </div>
      ) : null
    }

    <button
      type="button"
      class="filme filme--destaque revelar"
      data-filme-abrir
      data-filme-card
      data-tipo={tipoDoFilme(destaque)}
      data-youtube-id={destaque.youtubeId}
      data-titulo={destaque.titulo}
      data-url={destaque.url}
      aria-label={`Assistir ${destaque.titulo}`}
    >
      <div class="filme__capa">
        {capaDestaque ? <img src={capaDestaque} alt="" loading="lazy" /> : null}
        <div class="filme__play">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><polygon points="8,5 20,12 8,19"></polygon></svg>
          </span>
        </div>
        <span class="filme__badge">{rotulosTipoFilme[tipoDoFilme(destaque)]}</span>
      </div>
      <p class="filme__titulo">{destaque.titulo}</p>
      {metaDestaque ? <p class="filme__meta">{metaDestaque}</p> : null}
    </button>

    {
      grade.length > 0 ? (
        <div class="grade-filmes">
          {grade.map((filme, i) => {
            const capa = urlDaCapa(filme, slugTenant)
            const meta = metaDoFilme(filme)
            const tipo = tipoDoFilme(filme)
            return (
            <button
              type="button"
              class={`filme revelar revelar--${Math.min(i + 1, 3)}`}
              data-filme-abrir
              data-filme-card
              data-tipo={tipo}
              data-youtube-id={filme.youtubeId}
              data-titulo={filme.titulo}
              data-url={filme.url}
              aria-label={`Assistir ${filme.titulo}`}
            >
              <div class="filme__capa">
                {capa ? <img src={capa} alt="" loading="lazy" /> : null}
                <div class="filme__play">
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><polygon points="8,5 20,12 8,19"></polygon></svg>
                  </span>
                </div>
                <span class="filme__badge">{rotulosTipoFilme[tipo]}</span>
              </div>
              <p class="filme__titulo">{filme.titulo}</p>
              {meta ? <p class="filme__meta">{meta}</p> : null}
            </button>
            )
          })}
        </div>
      ) : null
    }

    {
      ocultosNoArquivo ? (
        <p class="filmes__mais revelar">
          <a href={linkArquivo}>Ver todos os filmes</a>
        </p>
      ) : null
    }
  </div>

  <div class="cinema" data-cinema hidden>
    <div class="cinema__backdrop" data-cinema-fechar tabindex="-1"></div>
    <div
      class="cinema__dialogo"
      role="dialog"
      aria-modal="true"
      aria-label="Player de filme"
      data-cinema-dialogo
    >
      <button type="button" class="cinema__fechar" data-cinema-fechar aria-label="Fechar">
        ×
      </button>
      <div class="cinema__palco" data-cinema-palco></div>
      <p class="cinema__titulo" data-cinema-titulo></p>
      <p class="cinema__erro" data-cinema-erro hidden>
        Não foi possível carregar o filme.
        <a data-cinema-escape href="#" target="_blank" rel="noopener noreferrer">Abrir no YouTube</a>
      </p>
    </div>
  </div>
</section>
  ) : null
}

<script>
  function montarEmbed(youtubeId: string): string {
    const params = new URLSearchParams({
      autoplay: '1',
      playsinline: '1',
      rel: '0',
      modestbranding: '1',
      iv_load_policy: '3',
      controls: '0',
      disablekb: '1',
      cc_load_policy: '0',
      fs: '1',
    })
    return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?${params}`
  }

  function iniciar() {
    const raiz = document.querySelector('[data-filmes-cinema]')
    if (!(raiz instanceof HTMLElement)) return
    if (raiz.dataset.cinemaPronto === '1') return
    raiz.dataset.cinemaPronto = '1'

    const cinema = raiz.querySelector('[data-cinema]')
    const palco = raiz.querySelector('[data-cinema-palco]')
    const tituloEl = raiz.querySelector('[data-cinema-titulo]')
    const erroEl = raiz.querySelector('[data-cinema-erro]')
    const escapeEl = raiz.querySelector('[data-cinema-escape]')
    if (
      !(cinema instanceof HTMLElement) ||
      !(palco instanceof HTMLElement) ||
      !(tituloEl instanceof HTMLElement) ||
      !(erroEl instanceof HTMLElement) ||
      !(escapeEl instanceof HTMLAnchorElement)
    ) {
      return
    }

    let ultimoFoco: HTMLElement | null = null

    function fechar() {
      cinema!.hidden = true
      document.body.classList.remove('cinema-aberto')
      palco!.replaceChildren()
      erroEl!.hidden = true
      ultimoFoco?.focus()
      ultimoFoco = null
    }

    function abrir(botao: HTMLElement) {
      const youtubeId = botao.dataset.youtubeId?.trim()
      const titulo = botao.dataset.titulo?.trim() || 'Filme'
      const url = botao.dataset.url?.trim() || '#'
      if (!youtubeId) return

      ultimoFoco = botao
      tituloEl!.textContent = titulo
      escapeEl!.href = url
      erroEl!.hidden = true
      palco!.replaceChildren()

      const iframe = document.createElement('iframe')
      iframe.src = montarEmbed(youtubeId)
      iframe.title = titulo
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      iframe.allowFullscreen = true
      iframe.referrerPolicy = 'strict-origin-when-cross-origin'
      iframe.addEventListener('error', () => {
        erroEl!.hidden = false
      })
      palco!.append(iframe)

      cinema!.hidden = false
      document.body.classList.add('cinema-aberto')
      const fecharBtn = cinema!.querySelector('.cinema__fechar')
      if (fecharBtn instanceof HTMLElement) fecharBtn.focus()
    }

    raiz.querySelectorAll('[data-filme-abrir]').forEach((el) => {
      el.addEventListener('click', () => {
        if (el instanceof HTMLElement) abrir(el)
      })
    })

    cinema.querySelectorAll('[data-cinema-fechar]').forEach((el) => {
      el.addEventListener('click', fechar)
    })

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !cinema.hidden) fechar()
    })

    const filtros = raiz.querySelector('[data-filmes-filtros]')
    if (filtros instanceof HTMLElement) {
      const chips = [...filtros.querySelectorAll<HTMLButtonElement>('[data-filtro]')]
      const cards = [...raiz.querySelectorAll<HTMLElement>('[data-filme-card]')]

      function aplicar(filtro: string) {
        for (const chip of chips) {
          chip.setAttribute('aria-pressed', chip.dataset.filtro === filtro ? 'true' : 'false')
        }
        for (const card of cards) {
          const tipo = card.dataset.tipo || 'casamento'
          const mostra = filtro === 'todos' || tipo === filtro
          card.hidden = !mostra
        }
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => aplicar(chip.dataset.filtro || 'todos'))
      })
    }
  }

  iniciar()
  document.addEventListener('astro:page-load', iniciar)
</script>
