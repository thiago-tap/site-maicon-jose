---
/**
 * Canais do contato (estilo Mikael): WhatsApp, Instagram, YouTube + link da agenda.
 */
type Props = {
  whatsappUrl?: string | null
  whatsappExibicao?: string
  instagramUrl?: string
  instagramUsuario?: string
  youtubeUrl?: string
  youtubeRotulo?: string
  agendaAtiva?: boolean
  agendaTexto?: string
}

const {
  whatsappUrl,
  whatsappExibicao = '',
  instagramUrl = '',
  instagramUsuario = '',
  youtubeUrl = '',
  youtubeRotulo = 'YouTube',
  agendaAtiva = false,
  agendaTexto = '',
} = Astro.props
---

<ul class="contato-canais revelar">
  {
    whatsappUrl ? (
      <li>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="contato-canal">
          <span class="contato-canal__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z" />
              <path d="M12.04 2C6.5 2 2.01 6.49 2.01 12.03c0 1.77.46 3.5 1.34 5.02L2 22l5.1-1.34A9.98 9.98 0 0 0 12.04 22C17.58 22 22.07 17.51 22.07 11.97 22.07 6.43 17.58 2 12.04 2zm0 18.18c-1.56 0-3.09-.42-4.42-1.22l-.32-.19-3.03.8.81-2.95-.21-.33a8.17 8.17 0 0 1-1.26-4.39c0-4.52 3.68-8.2 8.2-8.2 4.52 0 8.2 3.68 8.2 8.2 0 4.52-3.68 8.28-8.2 8.28z" />
            </svg>
          </span>
          <span class="contato-canal__texto">
            <strong>WhatsApp</strong>
            {whatsappExibicao ? <small>{whatsappExibicao}</small> : null}
          </span>
        </a>
      </li>
    ) : null
  }
  {
    instagramUrl ? (
      <li>
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="contato-canal">
          <span class="contato-canal__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="contato-canal__texto">
            <strong>Instagram</strong>
            {instagramUsuario ? <small>@{instagramUsuario}</small> : null}
          </span>
        </a>
      </li>
    ) : null
  }
  {
    youtubeUrl ? (
      <li>
        <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="contato-canal">
          <span class="contato-canal__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M23.5 7.2a3 3 0 0 0-2.1-2.1C19.5 4.5 12 4.5 12 4.5s-7.5 0-9.4.6A3 3 0 0 0 .5 7.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-4.8zM9.75 15.02V8.98L15.5 12l-5.75 3.02z" />
            </svg>
          </span>
          <span class="contato-canal__texto">
            <strong>YouTube</strong>
            <small>{youtubeRotulo}</small>
          </span>
        </a>
      </li>
    ) : null
  }
</ul>

{
  agendaAtiva ? (
    <p class="contato-agenda revelar">
      {agendaTexto ? <span class="contato-agenda__texto">{agendaTexto}</span> : null}
      <a href="/agenda" class="contato-agenda__link">
        Ver os meses disponíveis na agenda
      </a>
    </p>
  ) : null
}
