---
import Base from '../layouts/Base.astro'
import Menu from '../components/Menu.astro'
import FilmesCinema from '../components/FilmesCinema.astro'
import FilmesVerticais from '../components/FilmesVerticais.astro'
import Diferenciais from '../components/Diferenciais.astro'
import AgendaFaixa from '../components/AgendaFaixa.astro'
import Processo from '../components/Processo.astro'
import Faq from '../components/Faq.astro'
import FormularioContato from '../components/FormularioContato.astro'
import ContatoCanais from '../components/ContatoCanais.astro'
import HeroBannerFundo from '../components/HeroBannerFundo.astro'
import Flutuantes from '../components/Flutuantes.astro'
import { agendaTemMeses } from '../lib/agenda'
import { filmesFallback } from '../data/filmes'
import { iniciais } from '../lib/format'
import {
  DESCRICAO_SEO_PADRAO,
  TITULO_SEO_PADRAO,
  breadcrumbJsonLd,
  dadosNegocioJsonLd,
  faqJsonLd,
  imagemSocial,
  urlDoSite,
} from '../lib/seo'
import {
  buscarVitrine,
  linkWhatsapp,
  marcaDoSite,
  rotuloPreco,
} from '../lib/vitrine'

const dados = await buscarVitrine()
const marca = marcaDoSite(dados)
const especialidade =
  dados.inicio?.especialidade?.trim() ||
  dados.identidade?.especialidade?.trim() ||
  'Filmmaker de casamentos'
const frase =
  dados.inicio?.frase?.trim() ||
  dados.identidade?.frase?.trim() ||
  'O seu casamento contado com a emoção e a estética de um filme de cinema.'
const lema =
  dados.identidade?.lema?.trim() ||
  'Filmes de casamento clássicos, sensíveis e atemporais em Brasília e em qualquer destino onde o amor levar vocês.'
const descricao = dados.identidade?.descricao?.trim() || DESCRICAO_SEO_PADRAO
const cidade = [dados.identidade?.cidade, dados.identidade?.uf].filter(Boolean).join(' / ')
const sobreTitulo = dados.sobre?.titulo?.trim() || 'Sobre o Mayck'
const sobreTexto =
  dados.sobre?.apresentacao?.trim() ||
  dados.sobre?.resumo?.trim() ||
  'Filmes de casamento com olhar cinematográfico.'
const sobreEstilo = dados.sobre?.estilo?.trim()
const numeros = (dados.sobre?.numeros || []).filter(
  (n) => Number.isFinite(n.valor) && n.rotulo?.trim(),
)
const pacotes = [...(dados.pacotes || [])].sort((a, b) => a.ordem - b.ordem)
const extras = dados.extras || []
const depoimentos = [...(dados.depoimentos || [])].sort(
  (a, b) => (a.ordem ?? 0) - (b.ordem ?? 0),
)
const etapas = dados.comoFunciona || []
const diferenciais = dados.diferenciais || []
const faq = dados.faq || []
const whatsapp = linkWhatsapp(dados)
const instagramUsuario = dados.contato?.instagram?.usuario?.replace(/^@/, '').trim()
const instagramUrl =
  dados.contato?.instagram?.url?.trim() ||
  (instagramUsuario ? `https://www.instagram.com/${instagramUsuario}/` : '')
const monograma = iniciais(marca)
const filmes = dados.filmes?.length ? dados.filmes : filmesFallback
const slugTenant = dados.tenant?.slug?.trim() || 'maicon-jose'
const tituloSeo = TITULO_SEO_PADRAO
const paragrafosSobre = sobreTexto.split(/\n\n+/).map((p) => p.trim()).filter(Boolean)
const youtubeUrl = dados.contato?.youtube?.url?.trim() || ''
const youtubeRotulo = dados.contato?.youtube?.rotulo?.trim() || 'Mayck Filmes'
const temAgenda = agendaTemMeses(dados.agenda)
const og = imagemSocial(dados)
const dadosEstruturados = [
  dadosNegocioJsonLd(dados, `${urlDoSite()}/`),
  faqJsonLd(faq.map((f) => ({ pergunta: f.pergunta, resposta: f.resposta }))),
  breadcrumbJsonLd([{ nome: 'Início', caminho: '/' }]),
]
---

<Base
  titulo={tituloSeo}
  descricao={descricao}
  imagemOg={og}
  caminhoCanonico="/"
  dadosEstruturados={dadosEstruturados}
>
PLACEHOLDER_REMAINING