---
import '../styles/fonts.css'
import '../styles/global.css'
import { absoluto, truncarMeta } from '../lib/seo'
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url'
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url'

type Props = {
  titulo: string
  descricao?: string
  imagemOg?: string
  caminhoCanonico?: string
  /** JSON-LD objects (sem @context — o layout envelopa). */
  dadosEstruturados?: Array<Record<string, unknown> | null | undefined>
  semIndice?: boolean
}

const {
  titulo,
  descricao = titulo,
  imagemOg,
  caminhoCanonico,
  dadosEstruturados = [],
  semIndice = false,
} = Astro.props

const descricaoMeta = truncarMeta(descricao)
const caminho = caminhoCanonico || Astro.url.pathname || '/'
const canonica = absoluto(caminho)
const ogImagem = imagemOg?.startsWith('http') ? imagemOg : imagemOg ? absoluto(imagemOg) : undefined
const jsons = dadosEstruturados.filter(Boolean) as Record<string, unknown>[]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricaoMeta} />
    {semIndice ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="author" content="Mayck Filmes" />
    <meta name="geo.region" content="BR-DF" />
    <meta name="geo.placename" content="Brasília" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Mayck Filmes" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricaoMeta} />
    <meta property="og:url" content={canonica} />
    {
      ogImagem ? (
        <>
          <meta property="og:image" content={ogImagem} />
          <meta property="og:image:alt" content={titulo} />
        </>
      ) : null
    }

    <meta name="twitter:card" content={ogImagem ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricaoMeta} />
    {ogImagem ? <meta name="twitter:image" content={ogImagem} /> : null}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <link
      rel="preload"
      href={outfitLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={cormorant500}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsons.map((dados) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', ...dados }).replace(/</g, '\\u003c')}
        />
      ))
    }
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <div id="conteudo">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .pular-conteudo {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--ouro);
    color: var(--noite);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pular-conteudo:focus {
    left: var(--pad);
    top: 0.75rem;
  }
</style>
